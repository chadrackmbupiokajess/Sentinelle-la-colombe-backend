# Réglages du backend Sentinelle — copiez ce fichier en « .env » (jamais envoyé sur git).
# Sur PythonAnywhere, le fichier .env est lu automatiquement par wsgi.py.

# Base de données : EN DEHORS du dossier git, pour qu'un « git pull » ne l'écrase jamais.
# Exemple PythonAnywhere : /home/VOTRE_NOM/donnees/sentinelle.db
SENTINELLE_BD=/home/VOTRE_NOM/donnees/sentinelle.db

# Adresse(s) du frontend autorisée(s) à appeler l'API (séparées par des virgules).
SENTINELLE_ORIGINES=https://votre-site.vercel.app

# Masquer la documentation de l'API en production.
SENTINELLE_DOCS=0

# Notifications push : générez les clés avec  python generer_cles_push.py
SENTINELLE_VAPID_PUBLIC_KEY=
SENTINELLE_VAPID_PRIVATE_KEY=
SENTINELLE_VAPID_SUBJECT=mailto:vous@exemple.com

# Mode AJAX : un soignant reste « en ligne » s'il a interrogé le serveur dans ce délai (secondes).
# SENTINELLE_PRESENCE_S=90
